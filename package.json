{
  "name": "dsh-clean-sessions",
  "version": "1.0.0",
  "description": "Clean up archived DSH (DeepSeek Harness) sessions: remove session log directories and sync the archive list safely.",
  "author": "idleRain",
  "license": "MIT",
  "private": false,
  "homepage": "https://github.com/idleRain/dsh-clean-sessions#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idleRain/dsh-clean-sessions.git"
  },
  "bugs": {
    "url": "https://github.com/idleRain/dsh-clean-sessions/issues"
  },
  "type": "module",
  "bin": {
    "dsh-clean-sessions": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "sessions",
    "cleanup",
    "archive",
    "cli"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "start": "node dist/cli.js",
    "dev": "node src/cli.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.0"
  }
}
